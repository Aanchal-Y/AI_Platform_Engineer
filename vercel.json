{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/client/build/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/build/$1"
    }
  ]
}